+"""Scheduled portfolio replay from typed signals and separate raw H1 quotes."""
+from __future__ import annotations
+from dataclasses import replace
+import numpy as np
+import pandas as pd
+from core.execution_policy_20261003 import get_policy,quote_metadata,checks_between,latest_completed,closure_deadline,truthy
+from core.hourly_four_symbol_selector_20260928 import select_portfolio_entries
+
+SCENARIOS=(
+    'Fixed TP/SL','Dynamic TP/Dynamic SL','Dynamic TP/Middle Bias (no normal SL)',
+    'Dynamic TP/Middle Bias + Emergency SL','Fixed TP/Middle Bias (no normal SL)',
+    'Fixed TP/Printed Dynamic SL','Fixed TP/Higher Bias (no normal SL)',
+    'Fixed TP/Lower Bias (no normal SL)',
+)
+
+def normalize_quotes(frame):
+    aliases={'Datetime':'open_time','Open Price':'open','Open':'open','Highest Price':'high','High Price':'high','High':'high',
+        'Lowest Price':'low','Low Price':'low','Low':'low','Close Price':'close','Close':'close','Volume':'volume','symbol':'Symbol'}
+    f=frame.rename(columns={k:v for k,v in aliases.items() if k in frame and v not in frame}).copy()
+    if not {'Symbol','open_time','open','high','low','close'}.issubset(f): raise ValueError('Raw quotes need Symbol, open_time and OHLC')
+    f['Symbol']=f.Symbol.astype(str).str.upper().str.replace(r'[/_ ]','',regex=True)
+    f['open_time']=pd.to_datetime(f.open_time,errors='coerce',utc=True)
+    for col in ('open','high','low','close'): f[col]=pd.to_numeric(f[col],errors='coerce')
+    pieces=[]
+    for sym,g in f.groupby('Symbol',sort=True):
+        g=g.sort_values('open_time',kind='mergesort').reset_index(drop=True)
+        metadata=quote_metadata(g)
+        g=g.drop(columns=[c for c in metadata if c in g],errors='ignore')
+        pieces.append(pd.concat((g,metadata),axis=1))
+    return pd.concat(pieces,ignore_index=True)
+
+
+def _pip(sym): return .01 if 'JPY' in sym else .0001
+
+
+def _trade(signal,quotes,biases,check_at,scenario,tp_pips,sl_pips,p,ambiguity):
